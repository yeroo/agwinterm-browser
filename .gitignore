# upstream sources kept locally for reference only, never committed
.reference/

# rust
target/

# node
node_modules/
dist/
out/

# revmux rounds: keep what a future reader needs — the round's input/ (what the
# panel was pointed at), findings.json and report.md (what it concluded). Drop
# the per-run machinery: composed prompts, per-agent transcripts, event logs.
# Not only noise — revmux names verify-stage prompts after the directories they
# cover, and those names exceed the Windows path limit, so git cannot add them.
.revmux/tasks/*/*/prompts/
.revmux/tasks/*/*/agents/
.revmux/tasks/*/*/events.jsonl
.revmux/tasks/*/*/manifest.json
.revmux/tasks/*/*/output/
.revmux/tasks/*/*/logs/

*.log
.revmux/tasks/*/*/stages/

# vendored upstream build state
engine/packages/pixel-react/native/
*.snap.new
*.pending-snap
*.profraw
*.profdata
.env
.env.*

# Task 10's bring-up harness writes its measurements beside itself. The two
# `measured-*.tsv` the frame-budget doc's table is built from are committed; a
# re-measurement's output, the frames it produced, and agwinterm's own perf log
# are not — the last two are megabytes per run.
tools/milestone/frame-budget*.tsv
tools/milestone/*.log
tools/milestone/frame-*.png
tools/milestone/shot-*.png
